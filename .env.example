# Copy to .env and fill in. .env is gitignored; never commit it, and never
# paste a key into an issue, a chat or a screenshot.
#
# Models, tried in the order LLM_PROVIDERS gives. The pipeline works without
# any of this: discovery, watching and triage passes 1-2 never call a model. A
# missing key degrades the system, it does not break it, and the dashboard
# says which. Every provider is capped in data/llm-limits.yaml - for everyone,
# and for each profile.

LLM_PROVIDERS=claude

# https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high - how much Claude thinks. Thinking is billed as output.
CLAUDE_EFFORT=low

# The low-cost model that reads new postings before Claude checks them.
RANK_FIRST_PASS=groq

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# https://openrouter.ai/keys - off in data/llm-limits.yaml (paid)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# TypeSafe's Jev - only for `jobsearch mail eval-jev` until it is evaluated
JEV_API_KEY=

# Whose search a command is for, when there are several profiles
# (or pass --profile). See profiles/README.md.
JOBSEARCH_PROFILE=
# Where profiles live, if not ./profiles, and where everything the agent
# works out goes (an uploaded resume included), if not ./var. To keep a real
# person's data out of this checkout, point both at a private folder.
JOBSEARCH_PROFILES=
JOBSEARCH_VAR=

# A URL or address job boards can reach whoever runs this copy at; it goes
# into the User-Agent of every request.
JOBSEARCH_CONTACT=

# One inbox, read-only - see docs/mail.md. MAIL_PROFILE is the profile it
# belongs to; no other profile reads it.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_PROFILE=

# The connector and its memory - see docs/connector.md.
CONNECTOR_SECRET=
DATABASE_URL=
